@page "/authors/create"
@rendermode InteractiveServer
@using AuthorMySQL.Data
@inject PubsDbContext Db
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Forms

<h3>著者の追加</h3>

<EditForm Model="@author" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>著者ID</label>
        <InputText class="form-control" @bind-Value="author.AuthorId" />
    </div>

    <div class="mb-3">
        <label>姓</label>
        <InputText class="form-control" @bind-Value="author.AuthorLastName" />
    </div>

    <div class="mb-3">
        <label>名</label>
        <InputText class="form-control" @bind-Value="author.AuthorFirstName" />
    </div>

    <div class="mb-3">
        <label>電話番号</label>
        <InputText class="form-control" @bind-Value="author.Phone" />
    </div>

    <div class="mb-3 form-check">
        <InputCheckbox class="form-check-input" @bind-Value="author.Contract" />
        <label class="form-check-label">契約中</label>
    </div>

    <div class="mt-3">
        <button class="btn btn-primary me-2" type="submit">保存</button>
        <button class="btn btn-secondary" type="button" @onclick="GoBack">キャンセル</button>
    </div>
    
</EditForm>

@code {
    private Author author = new();

    private async Task HandleValidSubmit()
    {
        Db.Authors.Add(author);
        await Db.SaveChangesAsync();
        Nav.NavigateTo("/authors");
    }
    
    private void GoBack()
    {
        Nav.NavigateTo("/authors");
    }

}